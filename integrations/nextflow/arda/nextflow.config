// Per-process config for the ARDA_ASSIGN module. `includeConfig` this from your pipeline config.
//
// ⛔ BREAKING vs the pre-2.28 module: `params.regime` is GONE. The library protocol now comes from
// nf-core/airrflow's own `--library_generation_method`, which an airrflow samplesheet already
// carries, and the organism from the samplesheet's required `species` column. See README.md.

params {
    // ── FROM airrflow, consumed by this module ────────────────────────────────────────────────
    // `library_generation_method` selects arda's mode. The two tuning paths do NOT compose and
    // arda owns which flags each implies, so this is the ONLY protocol knob:
    //   specific_pcr | specific_pcr_umi | dt_5p_race | dt_5p_race_umi  -> arda amplicon
    //   trust4                                                          -> arda rnaseq
    //   sc_10x_genomics                                                 -> REFUSED (see main.nf)
    // Declared by airrflow itself; this module reads it and never defaults it, because guessing
    // the protocol is a silent 2-4x slowdown rather than an error.

    // ── FROM airrflow, deliberately NOT consumed here ─────────────────────────────────────────
    // `productive_only` -- arda has no productive filter and does not pretend to. It emits the
    //   AIRR `productive` column; airrflow's own filter step runs downstream and applies
    //   unchanged. Named here so nobody wires it to a flag that does not exist.
    // `reference_igblast` / `reference_fasta` / `fetch_germlines` -- arda does the IgBLAST work
    //   ONCE, offline, when its own reference is built, so there is no per-run germline database
    //   to stage. Point `--arda_organism` at the species instead; everything else is ignored.

    // ── arda-specific, all optional ───────────────────────────────────────────────────────────
    // Override the samplesheet's `species` column. null = use the sheet, which is where it
    // belongs. arda's reference is IMGT-derived, so only the SPECIES matters -- there is no
    // assembly to match and no iGenomes lookup to do.
    arda_organism = null

    // Absolute path to a specific mmseqs binary. null -> the module pins whatever the task's own
    // conda env / container provides. Set this only when mmseqs lives outside that environment.
    arda_mmseqs = null

    // Free-form extra arda flags, appended last (e.g. '--shm both', '--clonotype-key junction',
    // '--call-level gene', '--ec-mode fast', '--indel-rescue').
    //
    // ⚠ These were separate `arda_*` params before 2.28 and are now one passthrough, on purpose:
    // each is a DECISION about what a clonotype is or what is reported, not a tuning knob, and
    // spelling them out in a pipeline config invited setting them without reading what they cost.
    // `arda <mode> --help` carries each one's measured effect. Do NOT put protocol flags or
    // --threads here: the module owns those.
    arda_args = ''
}

process {
    // Never: EVERY setting lives INSIDE `withName:`. Never lift `conda`, `container` or `ext` up
    // to bare `process { }` scope -- there they apply to EVERY process in the pipeline, and
    // Nextflow then silently builds a different arda *and* a different aligner for tools that
    // never asked for one. The module's own `conda` directive (main.nf) is the default; the
    // commented line below is the only correct place to override it.
    withName: 'ARDA_ASSIGN' {
        // conda = "${projectDir}/modules/local/arda/environment.yml"
        // container = '<your-registry>/arda-mapper:2.27.0'

        ext.args = { params.arda_args ?: '' }

        publishDir = [
            path: { "${params.outdir}/arda" },
            mode: params.getOrDefault('publish_dir_mode', 'copy'),
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}
