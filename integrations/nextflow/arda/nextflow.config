// Per-process config for the ARDA module. `includeConfig` this from your pipeline's config
// (e.g. workflows/rnaseq/nextflow.config), mirroring how the other tool modules are wired.

params {
    // ── Which tuning regime arda runs in. The two paths do NOT compose; see main.nf. ──────────
    //   'amplicon'  targeted RepSeq / 5'RACE  -> --two-pass --fast-segments --v-only-on-segment
    //   'bulk'      whole-transcriptome       -> --prefilter
    //   'default'   the shipped one-pass path -> no tuning flags
    // Override per run with `--regime amplicon`, or per sample with a `regime` key in the meta map.
    regime = 'bulk'

    // Off by default and deliberately NOT part of the amplicon preset: its value tracks somatic
    // hypermutation load (+181 reads on a hypermutated repertoire, -14 on a naive one), so it is a
    // per-library call. Requires regime 'amplicon'.
    arda_indel_rescue = false

    // Reference organism. null -> derived from `params.genome` below (human if that is unset too).
    arda_organism = null

    // Absolute path to a specific mmseqs binary. null -> the module pins whatever the task's own
    // conda env / container provides. Set this only when mmseqs lives outside that environment.
    arda_mmseqs = null

    // ── Denoising. Default `fast` = arda's historical behaviour, so an existing pipeline that
    //    sets nothing is byte-unchanged. ────────────────────────────────────────────────────────
    //   fast      the abundance error model only. Anything abundance-driven: overlap, diversity,
    //             clonal expansion.
    //   accurate  + a Phred gate on the base that discriminates a clonotype from its parent.
    //             Low-frequency variants matter: spike-ins, MRD tracking, monoclonal QC.
    //   amplicon  + a quality-directed rescue searching 12 substitutions at a 50x abundance ratio.
    //             A targeted library is DEEP, so a 1-read neighbour of an abundant clone is almost
    //             always error.
    //   rnaseq    + the same rescue kept narrow (6 subs, 200x). Bulk RNA-seq is 0.02-3 % receptor
    //             and its singletons are mostly REAL.
    // ⛔ Nothing in any mode discards a read: a clonotype with no qualifying parent keeps its
    //    reads and is reported as an orphan. Set per sample with an `ec_mode` key in the meta map.
    arda_ec_mode = 'fast'

    // ── The clonotype KEY. `junction` canonicalises V/J to the junction's majority, so CALL
    //    SPLITS collapse: a junction byte-identical to an abundant clone's under a different V or
    //    J call, which no error model can reach because there is no discriminating base. Measured
    //    cost on a polyclonal TRA amplicon: 132 of 19,956 clonotypes merge (0.66 %). OFF by
    //    default because it changes what a clonotype IS -- a decision, not a tuning knob. ───────
    arda_clonotype_key = 'full'

    // Free-form extra arda flags, appended last (e.g. '--reconstruct', '--min-score 0').
    // Do NOT put regime flags or --threads here: the module owns those.
    arda_args = ''
}

process {
    // ⛔ Every ARDA setting lives INSIDE `withName:`. Never lift `conda`, `container` or `ext` up
    // to bare `process { }` scope -- there they apply to EVERY process in the pipeline, and
    // Nextflow then silently builds a different arda *and* a different aligner for tools that
    // never asked for one. The module's own `conda` directive (main.nf) is the default; the
    // commented line below is the only correct place to override it.
    withName: 'ARDA' {
        // conda = "${projectDir}/modules/local/arda/environment.yml"

        // Run only on an assembly arda has a reference for. arda's reference is IMGT-derived, so
        // only the SPECIES matters -- GRCh37 and GRCh38 are the same reference to it. An explicit
        // `--arda_organism` overrides the gate; an unset `params.genome` (standalone runs, or a
        // pipeline that does not use iGenomes) does not block the module.
        // `params.getOrDefault('genome', null)`, never a bare `params.genome`: a pipeline that
        // does not use iGenomes never defines it, and a bare read emits "Access to undefined
        // parameter" -- a WARN normally, a hard failure under strict mode. This config must not
        // declare `genome` itself either: includeConfig'd after the host's params block, that
        // would silently reset the host pipeline's genome to null.
        ext.when = {
            def genome = params.getOrDefault('genome', null)
            params.arda_organism != null ||
            genome == null ||
            genome in ['GRCh38', 'GRCh37', 'GRCm39', 'GRCm38']
        }

        // Organism + any free-form extras. The regime flags are NOT set here: main.nf owns them,
        // so the module stays correct even if a pipeline forgets to includeConfig this file.
        ext.args = {
            def species  = ['GRCh38': 'human', 'GRCh37': 'human',
                            'GRCm39': 'mouse', 'GRCm38': 'mouse']
            def genome   = params.getOrDefault('genome', null)
            def organism = params.arda_organism ?: (species[genome] ?: 'human')
            "--organism ${organism} ${params.arda_args ?: ''}".trim()
        }

        publishDir = [
            path: { "${params.outdir}/arda" },
            mode: params.getOrDefault('publish_dir_mode', 'copy'),
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}
